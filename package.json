{
  "name": "context-pi-extensions",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "extensions/pi-job",
    "extensions/pi-stash",
    "extensions/pi-subagent",
    "extensions/pi-system-insights",
    "extensions/pi-todo",
    "extensions/pi-tldr",
    "extensions/pi-dashboard",
    "packages/pi-session-tree",
    "packages/pi-foundations",
    "packages/pi-ui",
    "packages/pi-scripted-model",
    "packages/pi-test-helpers",
    "packages/pi-work",
    "extensions/pi-ask",
    "extensions/pi-git",
    "test"
  ],
  "scripts": {
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "fix": "npm run format && npm run lint:fix && npm run format",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "node --test scripts/*.test.mjs && npm run test --workspaces --if-present",
    "verify:bundle": "node scripts/verify-bundle.mjs"
  },
  "description": "Personal collection of pi extensions, skills, and configurations",
  "keywords": [
    "pi-package"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-job/src/extension.ts",
      "./extensions/pi-stash/src/index.ts",
      "./extensions/pi-subagent/src/index.ts",
      "./extensions/pi-system-insights/src/index.ts",
      "./extensions/pi-todo/src/index.ts",
      "./extensions/pi-tldr/src/index.ts",
      "./extensions/pi-git/src/index.ts",
      "./extensions/pi-dashboard/src/index.ts",
      "./extensions/pi-ask/src/index.ts"
    ],
    "skills": [
      "./skills",
      "./extensions/pi-subagent/skills"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "^24.19.2",
    "ajv": "^8.20.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typebox": "1.3.27",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
