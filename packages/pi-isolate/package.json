{
  "name": "pi-isolate",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Whole-session Pi launcher using Anthropic Sandbox Runtime.",
  "bin": {
    "pi-launch": "bin/pi-launch.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "isolation.example.yaml"
  ],
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.83",
    "yaml": "2.9.1",
    "jiti": "2.7.0"
  },
  "imports": {
    "#src/*": "./src/*.ts",
    "#test/*": "./test/*.ts",
    "#test-helpers": "pi-test-helpers",
    "#scripted-model/*": "pi-scripted-model/*"
  },
  "scripts": {
    "probe": "PI_ISOLATE_PROBE=1 npm run test:workspace --prefix ../.. -- packages/pi-isolate",
    "probe:network": "PI_ISOLATE_NETWORK_PROBE=1 PI_ISOLATE_PROBE=1 npm run test:workspace --prefix ../.. -- packages/pi-isolate"
  }
}
