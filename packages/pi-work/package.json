{
  "name": "pi-work",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "The work:v1 contract: what a Pi session waits on, a root work host, and boundary delivery of work messages.",
  "files": [
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "oxfmt --check . && oxlint --deny-warnings . && npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fix": "oxfmt --write . && oxlint --fix . && oxfmt --write ."
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "imports": {
    "#src/*": "./src/*.ts",
    "#test/*": "./test/*.ts",
    "#foundations/*": "pi-foundations/*",
    "#session-state": "pi-session-state",
    "#session-tree": "pi-session-tree",
    "#test-helpers": "pi-test-helpers"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  }
}
