{
  "name": "pi-todo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Session-scoped dependency-aware tasks with subagent-style Pi UX.",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "files": [
    "src",
    "README.md",
    "UPSTREAM.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "imports": {
    "#src/*": "./src/*.ts",
    "#test/*": "./test/*.ts",
    "#foundations/*": "pi-foundations/*",
    "#session-state": "pi-session-state",
    "#session-tree": "pi-session-tree",
    "#test-helpers": "pi-test-helpers",
    "#ui": "pi-ui",
    "#surface": "pi-surface"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  }
}
