{
  "name": "pi-subagent",
  "version": "23.2.0",
  "private": true,
  "type": "module",
  "files": [
    "src",
    "agents",
    "skills",
    "docs/*.md",
    "docs/architecture",
    "docs/decisions",
    "CHANGELOG.md"
  ],
  "imports": {
    "#src/*": "./src/*.ts",
    "#test/*": "./test/*.ts",
    "#foundations/*": "pi-foundations/*",
    "#job": "pi-job",
    "#job/*": "pi-job/*",
    "#session-state": "pi-session-state",
    "#session-tree": "pi-session-tree",
    "#test-helpers": "pi-test-helpers",
    "#todo": "pi-todo",
    "#ui": "pi-ui",
    "#work": "pi-work"
  },
  "description": "A focused, in-process sub-agent core for pi \u2014 autonomous agents plus lifecycle events other extensions build on. Friendly fork of @tintinweb/pi-subagents.",
  "author": {
    "name": "Chris Lasher"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gotgenes/pi-packages.git",
    "directory": "packages/pi-subagents"
  },
  "homepage": "https://github.com/gotgenes/pi-packages/tree/main/packages/pi-subagents#readme",
  "bugs": {
    "url": "https://github.com/gotgenes/pi-packages/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "subagent",
    "agent",
    "autonomous"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "video": "https://github.com/gotgenes/pi-subagents/raw/main/media/demo.mp4",
    "image": "https://github.com/gotgenes/pi-subagents/raw/main/media/screenshot.png"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  }
}
