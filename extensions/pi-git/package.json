{
  "name": "pi-git",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Git worktrees an orchestrator creates in any repository and hands to subagents, recorded in the session ledger",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "files": [
    "src",
    "README.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "oxfmt --check . && oxlint --deny-warnings . && npm run typecheck",
    "fix": "oxfmt --write . && oxlint --fix . && oxfmt --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
