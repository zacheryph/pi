{
  "name": "pi-stash",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Handle-based working-set store: keep large text outside the model context and read it by slice.",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "files": [
    "src",
    "README.md"
  ],
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "oxfmt --check . && oxlint --deny-warnings . && npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fix": "oxfmt --write . && oxlint --fix ."
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
