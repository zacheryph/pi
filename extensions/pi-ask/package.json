{
  "name": "pi-ask",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One ask tool, routed by session: a subagent asks its parent agent, the root session asks the user in an inline window",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "files": [
    "src",
    "README.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "oxfmt --check . && oxlint --deny-warnings . && npm run typecheck",
    "fix": "oxfmt --write . && oxlint --fix . && oxfmt --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "imports": {
    "#src/*": "./src/*.ts",
    "#test/*": "./test/*.ts",
    "#foundations/*": "pi-foundations/*",
    "#session-tree": "pi-session-tree",
    "#test-helpers": "pi-test-helpers",
    "#ui": "pi-ui",
    "#work": "pi-work"
  }
}
