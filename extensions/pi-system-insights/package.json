{
  "name": "pi-system-insights",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only Pi session inspectors for the system prompt, tools, and skill loading evidence.",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "files": [
    "src",
    "README.md"
  ],
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "oxfmt --check . && oxlint --deny-warnings . && npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fix": "oxfmt --write . && oxlint --fix . && oxfmt --write ."
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
