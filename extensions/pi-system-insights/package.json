{
  "name": "pi-system-insights",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only Pi session inspectors for the system prompt, tools, and skill loading evidence.",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "files": [
    "src",
    "README.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "imports": {
    "#src/*": "./src/*.ts",
    "#test/*": "./test/*.ts",
    "#foundations/*": "pi-foundations/*",
    "#test-helpers": "pi-test-helpers",
    "#ui": "pi-ui"
  }
}
