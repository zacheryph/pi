{
  "name": "pi-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local web dashboard of running interactive Pi sessions.",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "files": [
    "src",
    "README.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "imports": {
    "#src/*": "./src/*.ts",
    "#test/*": "./test/*.ts",
    "#foundations/*": "pi-foundations/*",
    "#git/*": "pi-git/*",
    "#session-state": "pi-session-state",
    "#stash/*": "pi-stash/*",
    "#subagent/*": "pi-subagent/*",
    "#surface": "pi-surface",
    "#test-helpers": "pi-test-helpers",
    "#todo/*": "pi-todo/*",
    "#presentation": "pi-presentation",
    "#presentation/*": "pi-presentation/*"
  }
}
