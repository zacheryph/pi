  "engines": { "node": ">=24" },
  "scripts": { "check": "tsc --noEmit", "test": "vitest run", "test:watch": "vitest" },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "pi": { "extensions": ["./src/index.ts"] }
