{
  "name": "pi-tldr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Concise Pi session summaries and optional short terminal-tab names.",
  "keywords": ["pi-package", "pi-extension"],
  "files": ["src", "README.md"],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
