{
  "name": "pi-job",
  "version": "0.3.1",
  "private": true,
  "description": "Background shell jobs and watches that wake the pi agent on completion",
  "license": "MIT",
  "author": "woksin",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "background-jobs",
    "shell"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woksin/pi-jobs.git"
  },
  "homepage": "https://github.com/woksin/pi-jobs#readme",
  "bugs": {
    "url": "https://github.com/woksin/pi-jobs/issues"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "type": "module",
  "scripts": {
    "check": "oxfmt --check . && oxlint --deny-warnings . && npm run typecheck",
    "test": "node --test --test-timeout=30000 'test/*.test.ts'",
    "typecheck": "tsc --noEmit && for f in e2e/*.mjs; do node --check \"$f\" || exit 1; done",
    "fix": "oxfmt --write . && oxlint --fix . && oxfmt --write ."
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "imports": {
    "#src/*": "./src/*.ts",
    "#test/*": "./test/*.ts",
    "#foundations/*": "pi-foundations/*",
    "#session-tree": "pi-session-tree",
    "#test-helpers": "pi-test-helpers",
    "#work": "pi-work"
  },
  "exports": {
    ".": "./src/extension.ts",
    "./*": "./src/*.ts"
  }
}
