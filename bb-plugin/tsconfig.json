{
  "compilerOptions": {
    "strict": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "paths": {
      "@/*": ["./*"]
    },
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "skipLibCheck": false
  },
  "include": ["*.ts", "app.tsx", "ui", "components", "lib", "hooks", "test"]
}
