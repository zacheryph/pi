/** A fake ExtensionAPI that records what the factory registers. */
function harness() {
  const handlers = new Map<string, Function[]>();
  const tools = new Map<string, { name: string; execute: Function }>();
  const commands = new Map<string, { handler: Function }>();
  const pi = {
    on: vi.fn((event: string, handler: Function) => handlers.set(event, [...(handlers.get(event) ?? []), handler])),
    registerTool: vi.fn((tool: { name: string; execute: Function }) => tools.set(tool.name, tool)),
    registerCommand: vi.fn((name: string, command: { handler: Function }) => commands.set(name, command)),
  };
  {{factory}}(pi as unknown as ExtensionAPI);
  return { pi, handlers, tools, commands };
}

